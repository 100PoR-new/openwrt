/dts-v1/;

/* Bootloader installs ATF here (BL31 resident region, ~256 KiB). */
/memreserve/ 0x80000000 0x88000;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7563.dtsi"

/ {
	model = "Xiaomi BE5000";
	compatible = "xiaomi,be5000", "airoha,an7563", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon initcall_debug ignore_loglevel";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	/*
	 * Confirmed against a live BE5000: /sys/kernel/debug/gpio shows
	 * gpio-5 "reset" and gpio-12 "mesh" held on gpiochip0 (0-31),
	 * matching the vendor gpio-keys-polled node in the stock dtb.
	 */
	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&an7563_pinctrl 5 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		button-mesh {
			label = "mesh";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&an7563_pinctrl 12 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

/*
 * TODO: not yet added to an7563.dtsi (no pwm controller node exists
 * there yet). Stock dtb confirms:
 *   pwm@1fbf0234 { compatible = "airoha,airoha-pwm";
 *                   reg = <0x1fbf0234 0x20>, <0x1fbf0268 0x4>, <0x1fbf0298 0x24>; }
 *   channel 1 = orange, channel 4 = blue (pwm-rgb consumer node)
 * Needs an "airoha,en7581-pwm"-compatible node added to an7563.dtsi
 * first (mirroring en7581_pwm in an7581.dtsi) before this can be
 * wired up here. Left out of this diff on purpose - separate commit.
 */

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&snfi {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&spi_nand {
	airoha,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x0 0x60000>;
			read-only;
		};

		partition@1 {
			label = "u-boot-env";
			reg = <0x60000 0x20000>;
		};

		/*
		 * MAC offsets confirmed against a real Factory partition
		 * dump: chip-id 0x7992 (LE) at offset 0, two MAC addresses
		 * at 0x004/0x00a (mt76/mt7996-format eeprom, MT_EE_MAC_ADDR
		 * / MT_EE_MAC_ADDR2). Which MAC belongs to which radio
		 * band (2.4 vs 5 GHz) is not yet confirmed on real hardware
		 * - verify against `iw phy` once wifi@ nodes exist.
		 */
		partition@2 {
			label = "art";
			reg = <0x80000 0x40000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_wifi0: macaddr@4 {
					reg = <0x4 0x6>;
				};

				macaddr_wifi1: macaddr@a {
					reg = <0xa 0x6>;
				};
			};
		};

		partition@3 {
			compatible = "denx,fit";
			label = "firmware";
			reg = <0xc0000 0x4000000>;
		};
	};
};

&eth {
	status = "disabled";
};

/*
 * Keeping npu disabled for now - the real fix this round is the
 * switch conduit port (see an7563.dtsi), which was the actual
 * missing piece. Re-enable npu as a separate, isolated test later.
 */
&npu {
	status = "disabled";
};

&switch {
	status = "okay";
};

&gsw_port1 {
	status = "okay";
	label = "lan1";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_port2 {
	status = "okay";
	label = "lan2";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_port3 {
	status = "okay";
	label = "lan3";
};

&gsw_phy3 {
	status = "okay";
};

/*
 * EN8811H 2.5G PHY. MDIO address 0xf and reset-gpio 13/active-low
 * confirmed against a live BE5000: dmesg shows
 * "Airoha EN8811H mdio-bus--1:0f: PHY = 3a2 - a411", and
 * /etc/preinit's TCSUPPORT_CPU_AN7552 branch does:
 *   echo 13 > .../export; direction=out; value=0; sleep 1; value=1
 * i.e. active-low reset held for 1 full second before release.
 */
&mdio {
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0xf>;

		reset-gpios = <&an7563_pinctrl 13 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000000>;
		reset-deassert-us = <20000>;
	};
};

/*
 * gdm1 is now the switch's conduit port (see port@6 inside
 * switch/ports in an7563.dtsi, "ethernet = <&gdm1>") - this is what
 * makes gsw_port1/2/3 (lan1/2/3) actually reachable from the network
 * stack. It carries no external PHY of its own, just needs enabling.
 */
&gdm1 {
	status = "okay";
};

/*
 * EN8811H WAN now lives on gdm2 instead of gdm1, since gdm1 is the
 * switch's conduit port (see above) and can't simultaneously be a
 * standalone MAC for an external PHY.
 *
 * MAC address: nvmem-cells intentionally NOT set here for now.
 * Wiring gdm1's nvmem-cells to macaddr_wifi0 (an "art" partition
 * cell) previously caused a confirmed kernel panic during probe
 * (bus_find_device/klist_next crash inside of_get_mac_address_nvmem,
 * seen via full serial log + call trace on real hardware) - looked
 * like a race between the MTD/nvmem provider registering and eth's
 * probe running. Needs investigation into probe ordering /
 * EPROBE_DEFER handling before re-adding a real MAC source; for now
 * the driver falls back to a random MAC on boot.
 *
 * TODO: confirm gdm2 (reg=2) is really the correct MAC index for
 * EN8811H on this SoC - chosen by analogy with an7581.dtsi's gdm
 * numbering scheme, not yet verified via dmesg.
 */
&gdm2 {
	status = "okay";

	openwrt,netdev-name = "wan";

	phy-handle = <&en8811>;
	phy-mode = "2500base-x";
};
